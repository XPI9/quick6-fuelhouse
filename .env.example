# ---- Quick6 FuelHouse — environment ----
# Copy to ".env" and add your real key. Never commit .env.

# Anthropic (Claude) API key — the brain that builds the plans
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model for plan generation (Sonnet = best plans; set claude-haiku-4-5 for cheaper/faster)
FUEL_MODEL=claude-sonnet-5

# Max plans per IP per hour (no accounts yet)
FUEL_LIMIT=30

# Port
PORT=3300
